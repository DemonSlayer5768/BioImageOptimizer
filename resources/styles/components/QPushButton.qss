
/*=====================================
QPushButtons
===================================== */

QPushButton[cssClass="BlueButton"] {
    background-color: #42A5F5;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
}

QPushButton[cssClass="AquaButton"] {
    background-color: #65D6C6;
    color: #0b0f1a;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
}

QPushButton[cssClass="GreenButton"] {
    background-color: #388E3C;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
}


QPushButton[cssClass="YellowButton"] {
    background-color: #FFB74D;
    color: #0b0f1a;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
}


QPushButton[cssClass="RedButton"] {
    background-color: #EF5350;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
}

/* Estado deshabilitado */

QPushButton[cssClass="BlueButton"]:disabled,
QPushButton[cssClass="AquaButton"]:disabled,
QPushButton[cssClass="GreenButton"]:disabled,
QPushButton[cssClass="YellowButton"]:disabled,
QPushButton[cssClass="RedButton"]:disabled {
    background-color: #2F3E56;
    color: #8996A8;
    border: none;
}




/*=====================================
 QToolButtons
===================================== */


/* ==========================================
   PRIMARY BUTTON
========================================== */

QToolButton[cssClass="PrimaryButton"] {
    background-color: #1b2a41;
    color: #c8d3e0;

    border: 1px solid #2f3e56;
    border-radius: 12px;

    text-align: center;

    padding: 12px 10px;

    font-size: 12px;
    font-weight: 600;

    icon-size: 24px;
}

/* Hover */
QToolButton[cssClass="PrimaryButton"]:hover {
    background-color: #243552;
    border: 1px solid #65D6C6;
    color: #65D6C6;
}

/* Pressed */
QToolButton[cssClass="PrimaryButton"]:pressed {
    background-color: #0f172a;
    border: 1px solid #65D6C6;
}

/* Disabled */
QToolButton[cssClass="PrimaryButton"]:disabled {
    background-color: #111a2e;
    color: #59677a;
    border: 1px solid #1b2a41;
}
