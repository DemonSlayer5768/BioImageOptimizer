
/*=====================================
QPushButtons
===================================== */


/* ==========================================
   CONFIGURACIÓN GENERAL
   ========================================== */

QPushButton[cssClass="BlueButton"],
QPushButton[cssClass="AquaButton"],
QPushButton[cssClass="GreenButton"],
QPushButton[cssClass="YellowButton"],
QPushButton[cssClass="RedButton"] {

    background-color: transparent;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    padding: 5px 14px;
    min-height: 24px;
   
}

/* ==========================================
   BLUE BUTTON
   ========================================== */

QPushButton[cssClass="BlueButton"] {
    color: #42A5F5;
    border: 1px solid rgba(66, 165, 245, 0.40);
}

QPushButton[cssClass="BlueButton"]:hover {
    border: 1px solid #42A5F5;
    color: #64B5F6;
}

QPushButton[cssClass="BlueButton"]:pressed {
    border: 1px solid #1E88E5;
    color: #1E88E5;
}

/* ==========================================
   AQUA BUTTON
   ========================================== */

QPushButton[cssClass="AquaButton"] {
    color: #65D6C6;
    border: 1px solid rgba(101, 214, 198, 0.40);
}

QPushButton[cssClass="AquaButton"]:hover {
    border: 1px solid #65D6C6;
    color: #8BE5D9;
}

QPushButton[cssClass="AquaButton"]:pressed {
    border: 1px solid #45BBAE;
    color: #45BBAE;
}

/* ==========================================
   GREEN BUTTON
   ========================================== */

QPushButton[cssClass="GreenButton"] {
    color: #4CAF50;
    border: 1px solid rgba(76, 175, 80, 0.40);
}

QPushButton[cssClass="GreenButton"]:hover {
    border: 1px solid #4CAF50;
    color: #81C784;
}

QPushButton[cssClass="GreenButton"]:pressed {
    border: 1px solid #388E3C;
    color: #388E3C;
}

/* ==========================================
   YELLOW BUTTON
   ========================================== */

QPushButton[cssClass="YellowButton"] {
    color: #FFB74D;
    border: 1px solid rgba(255, 183, 77, 0.40);
}

QPushButton[cssClass="YellowButton"]:hover {
    border: 1px solid #FFB74D;
    color: #FFD180;
}

QPushButton[cssClass="YellowButton"]:pressed {
    border: 1px solid #F57C00;
    color: #F57C00;
}

/* ==========================================
   RED BUTTON
   ========================================== */

QPushButton[cssClass="RedButton"] {
    color: #EF5350;
    border: 1px solid rgba(239, 83, 80, 0.40);
}

QPushButton[cssClass="RedButton"]:hover {
    border: 1px solid #EF5350;
    color: #E57373;
}

QPushButton[cssClass="RedButton"]:pressed {
    border: 1px solid #C62828;
    color: #C62828;
}

/* ==========================================
   DISABLED - TODOS LOS BOTONES
   ========================================== */

QPushButton[cssClass="BlueButton"]:disabled,
QPushButton[cssClass="AquaButton"]:disabled,
QPushButton[cssClass="GreenButton"]:disabled,
QPushButton[cssClass="YellowButton"]:disabled,
QPushButton[cssClass="RedButton"]:disabled {

    background-color: transparent;
    color: #64748b;
    border: 1px solid rgba(47, 62, 86, 0.65);
}



/*=====================================
 QToolButtons
===================================== */


/* ==========================================
   PRIMARY BUTTON
========================================== */

QToolButton[cssClass="PrimaryButton"] {
    background-color: #1b2a41;
    color: #c8d3e0;

    border: 1px solid #2f3e56;
    border-radius: 12px;

    text-align: center;

    padding: 12px 10px;

    font-size: 12px;
    font-weight: 600;

    icon-size: 24px;
}

/* Hover */
QToolButton[cssClass="PrimaryButton"]:hover {
    background-color: #243552;
    border: 1px solid #65D6C6;
    color: #65D6C6;
}

/* Pressed */
QToolButton[cssClass="PrimaryButton"]:pressed {
    background-color: #0f172a;
    border: 1px solid #65D6C6;
}

/* Disabled */
QToolButton[cssClass="PrimaryButton"]:disabled {
    background-color: #111a2e;
    color: #59677a;
    border: 1px solid #1b2a41;
}
