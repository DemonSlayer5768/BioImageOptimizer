
QFrame[cssClass="Background"] {
    background-color: #0b0f1a;
    border: none;
}

QFrame[cssClass="Surface"] {
    background-color: transparent;
    border: none;
    border-radius: 20px;
}


QFrame[cssClass="Card"] {
    background-color: #1b2a41 ; 
    border: none;
    border-radius: 12px;
}


