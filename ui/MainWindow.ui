      <property name="styleSheet">
       <string notr="true">/*
QFrame{ 
background-color: #111a2e;
}

*/



QPushButton {
    background-color: #111a2e;
    color: #c8d3e0;

    border: 1px solid #1b2a41;
    border-radius: 8px;

    padding: 10px 14px;

    font-size: 14px;
    font-weight: 600;

    text-align: left;
}

/* Hover */
QPushButton:hover {
    background-color: #1b2a41;
    border: 1px solid #2f3e56;
    color: #65D6C6;
}

/* Pressed */
QPushButton:pressed {
    background-color: #0b0f1a;
    border: 1px solid #65D6C6;

    padding-top: 11px;
    padding-bottom: 9px;
}

/* Disabled */
QPushButton:disabled {
    background-color: #0b0f1a;
    color: #59677a;
    border: 1px solid #111a2e;
}
</string>
      </property>
