}

QComboBox:focus {
    border: 1px solid #65D6C6;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
}


QComboBox QAbstractItemView {
    background-color: #111a2e;
    border: 1px solid rgba(101, 214, 198, 0.45);
    border-radius: 8px;
    color: #c8d3e0;
    selection-background-color: rgba(101, 214, 198, 0.2);
    selection-color: #65D6C6;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
