           <property name="styleSheet">
            <string notr="true">/* GALERÍA */
QListWidget#listWidget_imagenes {
    background-color: #0b0f1a;
    border: none;
    outline: none;
    padding: 12px;
    color: #c8d3e0;
}

/* TARJETAS */
QListWidget#listWidget_imagenes::item {
    background-color: #111a2e;
    border: 1px solid #2f3e56;
    border-radius: 10px;
    padding: 8px;
    margin: 5px;
    color: #c8d3e0;
}

/* HOVER */
QListWidget#listWidget_imagenes::item:hover {
    background-color: #1b2a41;
    border: 1px solid #65D6C6;
}

/* SELECCIONADO */
QListWidget#listWidget_imagenes::item:selected {
    background-color: #1b2a41;
    border: 2px solid #65D6C6;
    color: #65D6C6;
}

/* SCROLLBAR */
QListWidget#listWidget_imagenes QScrollBar:vertical {
    background-color: #0b0f1a;
    width: 9px;
    border: none;
    margin: 0;
}

QListWidget#listWidget_imagenes QScrollBar::handle:vertical {
    background-color: #2f3e56;
    border-radius: 4px;
    min-height: 30px;
}

QListWidget#listWidget_imagenes QScrollBar::handle:vertical:hover {
    background-color: #65D6C6;
}

/* SCROLLBAR - forzar ocultar */
QListWidget#listWidget_imagenes QScrollBar:vertical {
    width: 0px;
    background: transparent;
}

QListWidget#listWidget_imagenes QScrollBar:horizontal {
    height: 0px;
    background: transparent;
}


QListWidget#listWidget_imagenes QScrollBar::add-line:vertical,
QListWidget#listWidget_imagenes QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
}

</string>
