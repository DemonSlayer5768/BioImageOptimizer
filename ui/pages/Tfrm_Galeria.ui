         <property name="styleSheet">
          <string notr="true">/* ========== LISTA / GALERÍA ========== */
QListWidget#listWidget_imagenes {
    background-color: #0b0f1a;
    border: none;
    outline: none;
    padding: 12px;
}

QListWidget#listWidget_imagenes::item {
    background-color: #111a2e;
    border: 1px solid #2f3e56;
    border-radius: 10px;
    padding: 8px;
    margin: 6px;
    color: #c8d3e0;
}

QListWidget#listWidget_imagenes::item:hover {
    background-color: #1b2a41;
    border-color: #65D6C6;
}

QListWidget#listWidget_imagenes::item:selected {
    background-color: #1b2a41;
    border: 2px solid #65D6C6;
    color: #65D6C6;
}

/* ========== SCROLLBAR ========== */
QScrollBar:vertical {
    background-color: #0b0f1a;
    width: 10px;
    margin: 0;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #2f3e56;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #65D6C6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}</string>
