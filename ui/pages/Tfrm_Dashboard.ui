                 <property name="styleSheet">
                  <string notr="true">QToolButton {
    background-color: #1b2a41;
    color: #c8d3e0;

    border: 1px solid #2f3e56;
    border-radius: 12px;
	text-align: center;
	padding: 12px 8px;

   /* padding: 12px 10px 10px 10px; más espacio arriba para el icono */
    font-size: 12px;
    font-weight: 600;

 
    icon-size: 24px;               /* tamaño del icono */
}

/* Hover */
QToolButton:hover {
    background-color: #243552;
    border: 1px solid #65D6C6;
    color: #65D6C6;
}

/* Pressed */
QToolButton:pressed {
    background-color: #0f172a;
    border: 1px solid #65D6C6;
}

/* Disabled */
QToolButton:disabled {
    background-color: #111a2e;
    color: #59677a;
    border: 1px solid #1b2a41;
}</string>
